{
  "name": "Pokémon PL/SQL Dev",
  "dockerComposeFile": "docker-compose.yml",
  "service": "workspace",
  "workspaceFolder": "/workspace",
  
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      },
      "extensions": [
        "Oracle.oracledevtools",
        "ms-python.python"
      ]
    }
  },

  "forwardPorts": [1521],

  "postCreateCommand": "pip install oracledb",
  
  "remoteUser": "vscode"
}